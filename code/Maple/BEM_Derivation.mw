<Group hide-input="false" labelreference="L234" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">v1_proc :=proc(vel, Omega)
local vh_func, T_func, mu, alpha_s, v, vi_it, i, T_it, vh_it:
v       := sqrt(vel[1]^2 + vel[2]^2 + vel[3]^2):
mu      := sqrt(vel[1]^2 + vel[2]^2)/(Omega*R):
alpha_s := arctan(vel[3], sqrt(vel[1]^2 + vel[2]^2)):
vh_func := unapply( sqrt(T / (2*rho*A)), T):
T_func  := unapply( a/4 * ( theta_0*(2/3 + mu^2) + theta_1*(1/2 + mu^2/2) + mu*alpha_s - v1/(Omega*R)) * sigma * rho * A * (Omega*R)^2,v1):
fsolve(vi = vh_func(T_func(vi))^2 / sqrt( (v*cos(alpha_s))^2 + (v*sin(alpha_s) + vi)^2),vi=1..20)
end proc:</Text-field>
</Input>
